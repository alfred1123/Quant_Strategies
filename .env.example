# Quant Strategies — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Vars prefixed with `export` are also sourced in bash scripts (psql, liquibase, extractddl).
# Vars without `export` are only read by Python (python-dotenv / api/main.py).

# ---------------------------------------------------------------------------
# Data Sources
# ---------------------------------------------------------------------------

# Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=your_key_here

# Glassnode (optional — on-chain data)
# GLASSNODE_API_KEY=your_key_here

# Yahoo Finance — no API key needed (uses yfinance library)
# Supported tickers: equities (AAPL), ETFs (SPY), indices (^GSPC), crypto (BTC-USD)

# Futu OpenD gateway (only needed for HK/US equity via Futu)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# NASDAQ Data Link (free key: https://data.nasdaq.com/account/profile)
NASDAQ_DATA_LINK_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# PostgreSQL — QuantDB (accessed via AWS SSM port-forward on localhost:5433)
# ---------------------------------------------------------------------------

export QUANTDB_HOST=localhost
export QUANTDB_PORT=5433
export QUANTDB_USERNAME=your_db_user
export QUANTDB_PASSWORD=your_db_password

# Optional: override the full psycopg conninfo string (takes precedence over individual vars above)
# export QUANTDB_CONNINFO=host=localhost port=5433 dbname=quantdb user=your_db_user password=your_db_password sslmode=require

# Used directly by psql CLI (avoids interactive password prompt)
export PGPASSWORD="${QUANTDB_PASSWORD}"

# ---------------------------------------------------------------------------
# Dev DB target (read by scripts/appctl.sh) — choose where `./scripts/appctl.sh
# dev start` connects:
#   prod   → AWS Aurora via SSM tunnel on 127.0.0.1:5433  (default — works for everyone)
#   local  → local Postgres 17 on 127.0.0.1:5432          (set up via ./scripts/dbctl.sh)
# Teammates without a local DB can leave this unset (defaults to prod).
# DB_TARGET=local
#
# Local DB connection (only used when DB_TARGET=local; defaults shown):
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=5432
# LOCAL_DB_NAME=quantdb
# LOCAL_DB_USER=quant_admin
# LOCAL_DB_PASSWORD=*****
#
# When DB_TARGET=local, `./scripts/appctl.sh dev start` ALSO brings up Redis +
# the Bun coordinator via docker-compose.dev.yml so REFDATA endpoints work.
# Requires docker + docker-compose-v2 on the host (see docs/architecture/dev-vs-prod.md).
# Override the coordinator's DB URL if your local credentials differ:
# LOCAL_QUANTDB_URL=postgresql://quant_admin:*****@127.0.0.1:5432/quantdb?sslmode=disable
# COORDINATOR_PORT=3001
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Liquibase (db/liquidbase/ migrations)
# ---------------------------------------------------------------------------

export LIQUIBASE_COMMAND_URL=jdbc:postgresql://localhost:5433/quantdb
export LIQUIBASE_COMMAND_USERNAME=your_db_user
export LIQUIBASE_COMMAND_PASSWORD=your_db_password

# ---------------------------------------------------------------------------
# FastAPI backend (api/)
# ---------------------------------------------------------------------------

# Comma-separated allowed CORS origins (no in-code default). Leave unset when
# the browser only talks to the API same-origin (e.g. nginx, or Vite /api proxy).
# Set for split-origin dev, e.g. VITE_API_URL=http://localhost:8000:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# USE_SSM=1 is now the default in docker-compose.yml.
# The API tries SSM Parameter Store first (/quant/dev/* for dev, /quant/prod/*
# for prod).  If SSM is unreachable (no AWS creds, offline), it falls back to
# this .env file automatically.
#
# To force .env-only mode (skip SSM), set USE_SSM=0 in your shell or here:
# USE_SSM=0
# APP_ENV=prod

# AWS region used when USE_SSM=1 (default: ap-southeast-1)
# AWS_REGION=ap-southeast-1

# ---------------------------------------------------------------------------
# Frontend (Vite dev server — frontend/)
# ---------------------------------------------------------------------------

# Backend API base URL proxied by Vite. Default assumes uvicorn on :8000.
# VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication (JWT cookie session — see docs/design/login.md §8.3)
# ---------------------------------------------------------------------------

# Symmetric secret for HS256 JWT signing. Generate with:
#   openssl rand -base64 32
# In production (APP_ENV=prod), this MUST be set — the API will refuse to start
# without it.  Store under SSM /quant/prod/JWT_SECRET (never commit).
# In dev mode (default), omitting this is fine — the API auto-generates a random
# secret on each startup (all prior sessions invalidate on restart).
# Rotation: change the value and restart — all existing sessions invalidate.
# Also required by the Bun coordinator (`coordinator/`) when run via docker-compose.
JWT_SECRET=replace_me_with_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Coordinator (`coordinator/` — Bun queue service, docker-compose service `coordinator`)
# ---------------------------------------------------------------------------

# Single postgres URL for the coordinator (postgres.js). Required when running the
# coordinator container. Include sslmode if your server expects TLS (typical for RDS).
# Host DB via SSM tunnel on the host (Linux may need host IP instead of host.docker.internal):
#   QUANTDB_URL=postgresql://quant_admin:YOUR_PASS@host.docker.internal:5433/quantdb?sslmode=require
# QUANTDB_URL=

# Optional: host port mapping (default 3001)
# COORDINATOR_PORT=3001
