# Quant Strategies — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Vars prefixed with `export` are also sourced in bash scripts (psql, liquibase, extractddl).
# Vars without `export` are only read by Python (python-dotenv / api/main.py).

# ---------------------------------------------------------------------------
# Data Sources
# ---------------------------------------------------------------------------

# Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=your_key_here

# Glassnode (optional — on-chain data)
# GLASSNODE_API_KEY=your_key_here

# Yahoo Finance — no API key needed (uses yfinance library)
# Supported tickers: equities (AAPL), ETFs (SPY), indices (^GSPC), crypto (BTC-USD)

# Futu OpenD gateway (only needed for HK/US equity via Futu)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# NASDAQ Data Link (free key: https://data.nasdaq.com/account/profile)
NASDAQ_DATA_LINK_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# PostgreSQL — QuantDB (accessed via AWS SSM port-forward on localhost:5433)
# ---------------------------------------------------------------------------

export QUANTDB_HOST=localhost
# Leave this commented: config/db-targets.json already declares 5433 for prod.
# Setting it to 5432 points "prod" at your local Postgres — the resolver now
# refuses that outright rather than connecting to the wrong database.
# export QUANTDB_PORT=5433
export QUANTDB_USERNAME=your_db_user
export QUANTDB_PASSWORD=your_db_password

# Optional: override the full psycopg conninfo string (takes precedence over individual vars above)
# export QUANTDB_CONNINFO=host=localhost port=5433 dbname=quantdb user=your_db_user password=your_db_password sslmode=require

# Used directly by psql CLI (avoids interactive password prompt)
export PGPASSWORD="${QUANTDB_PASSWORD}"

# ---------------------------------------------------------------------------
# Dev DB target — the one switch that decides which database everything talks
# to (the app, the worker, dbctl, Liquibase). Both ends are declared in
# config/db-targets.json; this only selects one:
#   prod   → AWS Aurora via SSM tunnel   (default — works for everyone)
#   local  → local Postgres 17           (set up via ./scripts/dbctl.sh)
# Teammates without a local DB can leave this unset (defaults to prod).
# DB_TARGET=local
#
# Local DB connection — overrides config/db-targets.json (defaults shown):
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=5432
# LOCAL_DB_NAME=quantdb
# LOCAL_DB_USER=quant_admin
# LOCAL_DB_PASSWORD=*****
#
# Prod DB port for Liquibase / SSM tunnel (scripts/liquibase-deploy.sh, dbctl dump):
# PROD_DB_PORT=5433
#
# When DB_TARGET=local, `./scripts/appctl.sh dev start` ALSO brings up Redis +
# the Python queue worker via docker-compose.dev.yml so backtest jobs run end
# to end. Requires docker + docker-compose-v2 on the host (see
# docs/architecture/dev-vs-prod.md). Override worker concurrency:
# MAX_CONCURRENT_WORKERS=1
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Liquibase (db/liquidbase/ migrations)
# ---------------------------------------------------------------------------

export LIQUIBASE_COMMAND_URL=jdbc:postgresql://localhost:5433/quantdb
export LIQUIBASE_COMMAND_USERNAME=your_db_user
export LIQUIBASE_COMMAND_PASSWORD=your_db_password

# ---------------------------------------------------------------------------
# FastAPI backend (api/)
# ---------------------------------------------------------------------------

# Comma-separated allowed CORS origins (no in-code default). Leave unset when
# the browser only talks to the API same-origin (e.g. nginx, or Vite /api proxy).
# Set for split-origin dev, e.g. VITE_API_URL=http://localhost:8000:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# USE_SSM=1 is now the default in docker-compose.yml.
# The API tries SSM Parameter Store first (/quant/dev/* for dev, /quant/prod/*
# for prod).  If SSM is unreachable (no AWS creds, offline), it falls back to
# this .env file automatically.
#
# To force .env-only mode (skip SSM), set USE_SSM=0 in your shell or here:
# USE_SSM=0
# APP_ENV=prod

# AWS region used when USE_SSM=1 (default: ap-southeast-1)
# AWS_REGION=ap-southeast-1

# Cloudflare API token — Zone DNS Edit for cloudflare-dns.sh;
# Zone SSL and Certificates Edit for cloudflare-origin-cert.sh
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_ORIGIN_CA_KEY=v1.0-...   # legacy alternative for origin cert API
# DOMAIN=algodaemon.com
# ORIGIN_IP=52.221.3.230

# ---------------------------------------------------------------------------
# Frontend (Vite dev server — frontend/)
# ---------------------------------------------------------------------------

# Backend API base URL proxied by Vite. Default assumes uvicorn on :8000.
# VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication (JWT cookie session — see docs/design/login.md §8.3)
# ---------------------------------------------------------------------------

# Symmetric secret for HS256 JWT signing. Generate with:
#   openssl rand -base64 32
# In production (APP_ENV=prod), this MUST be set — the API will refuse to start
# without it.  Store under SSM /quant/prod/JWT_SECRET (never commit).
# In dev mode (default), omitting this is fine — the API auto-generates a random
# secret on each startup (all prior sessions invalidate on restart).
# Rotation: change the value and restart — all existing sessions invalidate.
JWT_SECRET=replace_me_with_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Local Bybit testnet (DB_TARGET=local — scripts/bybit_local_testnet.py)
# ---------------------------------------------------------------------------
# Generate stable Fernet key (NOT the same as JWT_SECRET):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EXCHANGE_SECRETS_KEY must match the key used when credentials were saved, or re-save keys.
# USE_SSM=0
# DB_TARGET=local

CCXT_ITEST_USER_ID=d7612827-0e91-46c3-af0b-83606a4f24a5
CCXT_ITEST_CREDENTIAL_ID=3
CCXT_ITEST_APP_ID=34
CCXT_ITEST_INTERNAL_CUSIP=btcusdt.crypto
CCXT_ITEST_STRATEGY_ID=ed8ed3b8-4710-47d4-8f91-d24dd45709ba
CCXT_ITEST_STRATEGY_VID=3
CCXT_ITEST_QTY=0.01
CCXT_ITEST_PAPER=true
# EXCHANGE_SECRETS_KEY=                         # Fernet key — DB credential decrypt
# CCXT_ITEST_API_KEY=                           # optional: bypass DB for gateway tests
# CCXT_ITEST_API_SECRET=

# Bybit testnet — scripts/bybit_local_testnet.py --save
# BYBIT_TESTNET_API_KEY=
# BYBIT_TESTNET_API_SECRET=

# ---------------------------------------------------------------------------
# Backtest queue worker (`quant.queue.worker_loop` — docker-compose service `worker`)
# ---------------------------------------------------------------------------

# Maximum concurrent backtest worker subprocesses spawned by one worker_loop.
# Default 1. Bump only after BT.SP_CLAIM_NEXT becomes atomic (see
# docs/design/backtest-queue.md §0 follow-ups).
# MAX_CONCURRENT_WORKERS=1

# ---------------------------------------------------------------------------
# Ops alerts (Slack Incoming Webhook — optional; logs at ERROR if unset)
# ---------------------------------------------------------------------------

# Create at https://api.slack.com/apps → Incoming Webhooks → Add to workspace.
# URL looks like https://hooks.slack.com/services/T…/B…/…  (NOT your workspace login URL)
# SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Production Docker images (ECR — set by CI deploy on EC2, not hand-edited locally)
# ---------------------------------------------------------------------------
#
# When ECR pull deploy is active, the deploy workflow exports full image URIs:
#   IMAGE_TAG=<git-sha>
#   APP_IMAGE=539163478329.dkr.ecr.ap-southeast-1.amazonaws.com/quant-app:${IMAGE_TAG}
#   NGINX_IMAGE=539163478329.dkr.ecr.ap-southeast-1.amazonaws.com/quant-nginx:${IMAGE_TAG}
#
# Omit locally — docker-compose.yml defaults to quant-app:latest / quant-nginx:latest
# and `docker compose build` still works for dev and pre-ECR prod.
