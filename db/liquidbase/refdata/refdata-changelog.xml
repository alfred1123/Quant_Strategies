    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      REFDATA schema (refdata.databasechangelog).

      PRODUCTION SAFETY
      - Baseline: releases/archive/baseline-1.0.0.xml (REFERENCE ONLY — never <include> on prod).
      - Prod seed/DDL already applied; re-including archive may DELETE or ALTER live REFDATA.
      - Deploy applies ONLY changesets whose context includes prod-deploy.
        Anything else is manual: APP_ENV=prod USE_SSM=1 ./scripts/liquibase-deploy.sh

      NEW MIGRATION
      1. Add SQL under tables/, data/, or procedures/.
      2. Create releases/X.Y.Z-name.xml — order matters: ALTER TABLE before seeds that use new columns.
      3. Uncomment/add:
           <include file="releases/X.Y.Z-name.xml" relativeToChangelogFile="true"/>
      4. After deploy, refresh Redis REFDATA: POST /api/v1/refdata/refresh

      EDITING AN EXISTING PROCEDURE COUNTS AS A NEW MIGRATION.
      Applied releases are archived, so no runOnChange changeset is standing by to
      re-apply a body you edit. Write the changeset that deploys it, or the edit
      stays in git and prod keeps the old definition.
    -->

    <!-- Nothing pending. -->

</databaseChangeLog>
