    <!--
      SP_GET_QUEUE active rows come back newest CREATED_AT first.

      The jobs list and the worker shared one ascending scan. LIMIT 50
      then kept the oldest jobs, so a submission from today never reached
      My Jobs once a user had 50 rows. The parameter list is unchanged.

      The worker still claims the oldest queued job. It reorders the rows
      in Python (lowest PRIORITY, then earliest TRANSACT_FROM_TS).
    -->

    <changeSet id="1.25.0-001-sp-get-queue-newest-first" author="alfcheun" context="bt,prod-deploy">
        <comment>SP_GET_QUEUE — active rows newest CREATED_AT first</comment>
        <sqlFile path="../procedures/SP_GET_QUEUE.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="false"/>
        <rollback/>
    </changeSet>

</databaseChangeLog>
