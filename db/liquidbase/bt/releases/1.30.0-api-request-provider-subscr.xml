    <changeSet id="1.30.0-006-sp-detach-api-request-payload" author="alfcheun" context="bt,prod-deploy">
        <comment>MARKET_DATA.SP_DETACH_API_REQUEST_PAYLOAD replaces the BT procedure</comment>
        <sqlFile path="../../market_data/procedures/SP_DETACH_API_REQUEST_PAYLOAD.sql"
