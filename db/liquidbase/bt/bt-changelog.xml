<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      BT schema (bt.databasechangelog).

      PRODUCTION SAFETY
      - Baseline: releases/archive/baseline-1.0.0.xml (REFERENCE ONLY — never <include> on prod).
      - Archive includes bt-000-precleanup (DROP PROCEDURE) and table rollbacks — unsafe on prod.
      - Deploy applies ONLY changesets whose context includes prod-deploy.
        Anything else is manual: APP_ENV=prod USE_SSM=1 ./scripts/liquibase-deploy.sh

      NEW MIGRATION
      1. Add SQL under tables/, procedures/, or functions/.
      2. Create releases/X.Y.Z-name.xml — procedures need splitStatements="false".
      3. Uncomment/add:
           <include file="releases/X.Y.Z-name.xml" relativeToChangelogFile="true"/>

      EDITING AN EXISTING PROCEDURE COUNTS AS A NEW MIGRATION.
      Applied releases are archived, so no runOnChange changeset is standing by to
      re-apply a body you edit. Write the changeset that deploys it, or the edit
      stays in git and prod keeps the old definition.
    -->

    <!-- 1.18.0–1.23.0 applied on prod (through 2026-09-13) and archived. -->

    <include file="releases/1.24.0-api-limit-config-schema.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.25.0-sp-get-queue-newest-first.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
