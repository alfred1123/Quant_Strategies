<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========== BT tables ========== -->

    <changeSet id="205-bt-strategy" author="alfcheun" context="bt" runOnChange="false">
        <sqlFile path="tables/STRATEGY.sql" relativeToChangelogFile="true" splitStatements="true" stripComments="true"/>
        <rollback><sql>DROP TABLE IF EXISTS BT.STRATEGY;</sql></rollback>
    </changeSet>

    <changeSet id="206-bt-result" author="alfcheun" context="bt" runOnChange="false">
        <sqlFile path="tables/RESULT.sql" relativeToChangelogFile="true" splitStatements="true" stripComments="true"/>
        <rollback><sql>DROP TABLE IF EXISTS BT.RESULT;</sql></rollback>
    </changeSet>

    <!-- ========== BT procedures ========== -->

    <changeSet id="210-bt-proc-sp-ins-strategy" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_INS_STRATEGY.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="true"/>
        <rollback><sql>DROP PROCEDURE IF EXISTS BT.SP_INS_STRATEGY;</sql></rollback>
    </changeSet>

    <changeSet id="212-bt-proc-sp-ins-api-request" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_INS_API_REQUEST.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
        <rollback><sql>DROP PROCEDURE IF EXISTS BT.SP_INS_API_REQUEST;</sql></rollback>
    </changeSet>


    <!-- BT.QUEUE: soft-versioned state log (QUEUE_ID + QUEUE_VID PK). -->
    <changeSet id="221-bt-queue" author="alfcheun" context="bt" runOnChange="false">
        <sqlFile path="tables/QUEUE.sql" relativeToChangelogFile="true" splitStatements="true" stripComments="true"/>
        <rollback>
            <sql>DROP INDEX IF EXISTS BT.IX_QUEUE_STRATEGY;</sql>
            <sql>DROP INDEX IF EXISTS BT.IX_QUEUE_STATUS_CURRENT;</sql>
            <sql>DROP INDEX IF EXISTS BT.IX_QUEUE_USER_CURRENT;</sql>
            <sql>DROP TABLE IF EXISTS BT.QUEUE;</sql>
        </rollback>
    </changeSet>

    <!-- Single queue procedure — all state transitions via explicit params. -->
    <changeSet id="231-bt-proc-sp-ins-queue" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_INS_QUEUE.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_queue(UUID, INTEGER, UUID, INTEGER, INTEGER, INTEGER, TEXT, TEXT, TEXT, TEXT, TEXT);</sql>
        </rollback>
    </changeSet>

    <!-- Insert a completed backtest result; returns generated RESULT_ID. -->
    <changeSet id="232-bt-proc-sp-ins-result" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_INS_RESULT.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_result(UUID, JSONB, TEXT, INTEGER, TEXT, TEXT, TEXT);</sql>
        </rollback>
    </changeSet>

    <!-- Drop stale procedure overloads left from earlier signatures. -->
    <changeSet id="240-bt-drop-stale-overloads" author="alfcheun" context="proc" runOnChange="false">
        <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_queue(UUID, INTEGER, UUID, INTEGER, INTEGER, INTEGER, TEXT, TEXT, TEXT, TEXT, TEXT);</sql>
        <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_result(UUID, UUID, INTEGER, TIMESTAMPTZ, DATE, DATE, TEXT, NUMERIC, JSONB, JSONB, TEXT, TEXT, TEXT, TEXT);</sql>
        <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_strategy(UUID, TEXT, TEXT, TEXT, INTEGER, JSONB, TEXT, TEXT, TEXT, TEXT);</sql>
        <rollback><sql>-- stale overloads; no rollback needed</sql></rollback>
    </changeSet>

    <!-- Drop remaining stale sp_ins_result overload (wrong signature in 240). -->
    <changeSet id="241-bt-drop-stale-sp-ins-result" author="alfcheun" context="proc" runOnChange="false">
        <sql>DROP PROCEDURE IF EXISTS bt.sp_ins_result(UUID, INTEGER, TIMESTAMPTZ, DATE, DATE, TEXT, NUMERIC, JSONB, JSONB, TEXT);</sql>
        <rollback><sql>-- stale overload; no rollback needed</sql></rollback>
    </changeSet>

    <!-- Flexible queue reader: single job (all VIDs) or filtered active rows. Dynamic SQL + force_custom_plan. -->
    <changeSet id="250-bt-proc-sp-get-queue" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_GET_QUEUE.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS bt.sp_get_queue(UUID, UUID, INTEGER, TEXT, INTEGER, REFCURSOR, TEXT, TEXT, TEXT);</sql>
        </rollback>
    </changeSet>

    <!-- Active queue rows joined to current strategy version (IS_CURRENT_IND='Y') — for UI terminal display. -->
    <changeSet id="251-bt-proc-sp-get-queue-for-terminal" author="alfcheun" context="proc" runOnChange="true">
        <sqlFile path="procedures/SP_GET_QUEUE_FOR_TERMINAL.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS bt.sp_get_queue_for_terminal(TEXT, INTEGER, INTEGER, REFCURSOR, TEXT, TEXT, TEXT);</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
