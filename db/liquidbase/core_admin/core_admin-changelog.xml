<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      CORE_ADMIN schema (core_admin.databasechangelog).

      PRODUCTION SAFETY
      - Baseline: releases/archive/baseline-1.0.0.xml (REFERENCE ONLY — never <include> on prod).
      - Prod has live data; archive contains GRANTS and DDL with destructive rollbacks.
      - Deploy applies ONLY changesets whose context includes prod-deploy.
        Anything else is manual: APP_ENV=prod USE_SSM=1 ./scripts/liquibase-deploy.sh

      NEW MIGRATION
      1. Add SQL under tables/, procedures/, or sql/.
      2. Create releases/X.Y.Z-name.xml — sqlFile paths from releases/ use ../tables/ etc.
      3. Uncomment/add:
           <include file="releases/X.Y.Z-name.xml" relativeToChangelogFile="true"/>
      4. After objects in other schemas change, add a forward changeset for sql/GRANTS.sql
         (runOnChange=true) in a core_admin release file.
    -->

    <include file="releases/1.2.0-credential-check.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.3.0-grants-refresh.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
