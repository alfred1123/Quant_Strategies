<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.1.0-001-api-credential-table" author="alfcheun" context="core_admin" runOnChange="false">
        <comment>Phase 1.1 — CORE_ADMIN.API_CREDENTIAL table + quant_admin SELECT grant</comment>
        <sqlFile path="../tables/API_CREDENTIAL.sql" relativeToChangelogFile="true"
                 splitStatements="true" stripComments="true"/>
        <rollback><sql>DROP TABLE IF EXISTS CORE_ADMIN.API_CREDENTIAL;</sql></rollback>
    </changeSet>

    <changeSet id="1.1.0-002-sp-ins-api-credential" author="alfcheun" context="core_admin" runOnChange="true">
        <comment>Phase 1.1 — insert / rotate exchange API credential</comment>
        <sqlFile path="../procedures/SP_INS_API_CREDENTIAL.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
        <rollback><sql>DROP PROCEDURE IF EXISTS CORE_ADMIN.SP_INS_API_CREDENTIAL;</sql></rollback>
    </changeSet>

    <changeSet id="1.1.0-003-sp-get-api-credential" author="alfcheun" context="core_admin" runOnChange="true">
        <comment>Phase 1.1 — get exchange API credentials for app user</comment>
        <sqlFile path="../procedures/SP_GET_API_CREDENTIAL.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
        <rollback><sql>DROP PROCEDURE IF EXISTS CORE_ADMIN.SP_GET_API_CREDENTIAL;</sql></rollback>
    </changeSet>

    <changeSet id="1.1.0-004-sp-upd-api-credential-revoke" author="alfcheun" context="core_admin" runOnChange="true">
        <comment>Phase 1.1 — revoke exchange API credential (soft-version)</comment>
        <sqlFile path="../procedures/SP_UPD_API_CREDENTIAL_REVOKE.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
        <rollback><sql>DROP PROCEDURE IF EXISTS CORE_ADMIN.SP_UPD_API_CREDENTIAL_REVOKE;</sql></rollback>
    </changeSet>

</databaseChangeLog>
