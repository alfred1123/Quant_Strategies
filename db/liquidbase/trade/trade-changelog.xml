<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      TRADE schema (trade.databasechangelog).

      PRODUCTION SAFETY
      - Baseline: releases/archive/baseline-1.0.0.xml (REFERENCE ONLY — never <include> on prod).
      - Deploy applies ONLY changesets whose context includes prod-deploy.
        Anything else is manual: APP_ENV=prod USE_SSM=1 ./scripts/liquibase-deploy.sh

      NEW MIGRATION
      1. Add SQL under tables/ or procedures/.
      2. Create releases/X.Y.Z-name.xml
      3. Uncomment/add:
           <include file="releases/X.Y.Z-name.xml" relativeToChangelogFile="true"/>
      4. Add prod-deploy to each changeset context to ship it with the app.
    -->

    <include file="releases/1.5.0-log-duration-clock-timestamp.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.6.0-scheduled-instruments.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.7.0-execution-event-position.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.8.0-execution-log-reads.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
