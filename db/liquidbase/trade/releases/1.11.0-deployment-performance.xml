<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Strategy-level PnL reconcile.

      TRADE.DEPLOYMENT_PERFORMANCE stores one bar of live vs backtest return.
      FEE_CCY_CD on TRADE.TRANSACTION records the coin FEE_AMT was charged in,
      so a base-coin fee can be converted at the fill price when the bar is
      priced. Context is trade only: production apply waits until prod-deploy
      is added on purpose.

      CREATE OR REPLACE with a longer SP_INS_TRANSACTION argument list adds an
      overload and leaves the old signature in place. The drop changeset
      removes that old signature after the new body exists.
    -->

    <changeSet id="1.11.0-001-deployment-performance" author="alfcheun" context="trade">
        <comment>TRADE.DEPLOYMENT_PERFORMANCE — one current strategy bar</comment>
        <sqlFile path="../tables/DEPLOYMENT_PERFORMANCE.sql" relativeToChangelogFile="true"
                 splitStatements="true" stripComments="true"/>
        <rollback>
            <sql>DROP TABLE IF EXISTS TRADE.DEPLOYMENT_PERFORMANCE;</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.11.0-002-sp-ins-deployment-performance" author="alfcheun" context="trade">
        <comment>SP_INS_DEPLOYMENT_PERFORMANCE — insert, version, or no-op one bar</comment>
        <sqlFile path="../procedures/SP_INS_DEPLOYMENT_PERFORMANCE.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS TRADE.SP_INS_DEPLOYMENT_PERFORMANCE(UUID, UUID, INTEGER, UUID, INTEGER, TIMESTAMPTZ, CHAR(1), NUMERIC, NUMERIC, NUMERIC, NUMERIC, NUMERIC, NUMERIC, NUMERIC, TEXT, OUT TEXT, OUT TEXT, OUT TEXT);</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.11.0-003-sp-get-deployment-performance" author="alfcheun" context="trade">
        <comment>SP_GET_DEPLOYMENT_PERFORMANCE — current bars for the owner</comment>
        <sqlFile path="../procedures/SP_GET_DEPLOYMENT_PERFORMANCE.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="false"/>
        <rollback>
            <sql>DROP PROCEDURE IF EXISTS TRADE.SP_GET_DEPLOYMENT_PERFORMANCE(UUID, UUID, TIMESTAMPTZ, TIMESTAMPTZ, INTEGER, OUT REFCURSOR, OUT TEXT, OUT TEXT, OUT TEXT);</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.11.0-004-transaction-fee-ccy" author="alfcheun" context="trade">
        <comment>FEE_CCY_CD on TRADE.TRANSACTION — coin the raw FEE_AMT was charged in</comment>
        <sql splitStatements="true" stripComments="true">
            ALTER TABLE TRADE.TRANSACTION ADD COLUMN IF NOT EXISTS FEE_CCY_CD TEXT;
        </sql>
        <rollback>
            <sql>ALTER TABLE TRADE.TRANSACTION DROP COLUMN IF EXISTS FEE_CCY_CD;</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.11.0-005-sp-ins-transaction-fee-ccy" author="alfcheun" context="trade">
        <comment>SP_INS_TRANSACTION — persist IN_FEE_CCY_CD</comment>
        <sqlFile path="../procedures/SP_INS_TRANSACTION.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="false"/>
        <rollback/>
    </changeSet>

    <changeSet id="1.11.0-006-drop-sp-ins-transaction-overload" author="alfcheun" context="trade">
        <comment>Drop the pre-FEE_CCY_CD SP_INS_TRANSACTION overload</comment>
        <sql splitStatements="true" stripComments="true">
            DROP PROCEDURE IF EXISTS TRADE.SP_INS_TRANSACTION(
                UUID, UUID, INTEGER, INTEGER, INTEGER, TEXT, TEXT, TEXT, TEXT,
                NUMERIC, NUMERIC, NUMERIC, NUMERIC, TEXT, TEXT,
                OUT TEXT, OUT TEXT, OUT TEXT
            );
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="1.11.0-007-sp-get-transaction-fee-ccy" author="alfcheun" context="trade">
        <comment>SP_GET_TRANSACTION — return FEE_CCY_CD with the fill</comment>
        <sqlFile path="../procedures/SP_GET_TRANSACTION.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="false"/>
        <rollback/>
    </changeSet>

</databaseChangeLog>
