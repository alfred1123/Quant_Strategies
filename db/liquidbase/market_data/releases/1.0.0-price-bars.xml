<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0.0-001-price-bar" author="alfcheun" context="market_data,prod-deploy">
        <!--
          tables/PRICE_BAR.sql is the canonical DDL that db/syncddl/ is diffed
          against, so it tracks the current shape rather than the shape this
          changeset first created — SOURCE_APP_ID joined the key in 1.1.0.
          Databases that already ran this changeset are migrated there; this
          allowance only stops the edited file failing their checksum.
        -->
        <validCheckSum>ANY</validCheckSum>
        <comment>Phase 1.9 — MARKET_DATA.PRICE_BAR normalized OHLCV rows</comment>
        <sqlFile path="../tables/PRICE_BAR.sql" relativeToChangelogFile="true"
                 splitStatements="true" stripComments="true"/>
        <rollback><sql>DROP TABLE IF EXISTS MARKET_DATA.PRICE_BAR;</sql></rollback>
    </changeSet>

    <changeSet id="1.0.0-002-sp-ins-price-bar" author="alfcheun" context="market_data,prod-deploy" runOnChange="true">
        <comment>MARKET_DATA.SP_INS_PRICE_BAR — single-row insert</comment>
        <sqlFile path="../procedures/SP_INS_PRICE_BAR.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
    </changeSet>

    <changeSet id="1.0.0-003-sp-get-price-bar" author="alfcheun" context="market_data,prod-deploy" runOnChange="true">
        <comment>MARKET_DATA.SP_GET_PRICE_BAR — range read</comment>
        <sqlFile path="../procedures/SP_GET_PRICE_BAR.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
    </changeSet>

    <changeSet id="1.0.0-004-sp-get-price-bar-coverage" author="alfcheun" context="market_data,prod-deploy" runOnChange="true">
        <comment>MARKET_DATA.SP_GET_PRICE_BAR_COVERAGE — MIN/MAX via ORDER BY LIMIT 1 (crash catch-up + freshness)</comment>
        <sqlFile path="../procedures/SP_GET_PRICE_BAR_COVERAGE.sql" relativeToChangelogFile="true"
                 splitStatements="false" stripComments="true"/>
    </changeSet>

</databaseChangeLog>
